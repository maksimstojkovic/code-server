#!/bin/sh
# Runs before code-server starts (via the image's ENTRYPOINTD hook).
#
# - Ensures the configured workspace exists.
# - If the mounted home directory is owned by a different UID than the runtime
#   user (i.e. PUID was changed after data was written), re-chown it once.
#   Ownership matching the runtime user makes this a no-op.
set -eu

if [ -n "${DEFAULT_WORKSPACE-}" ]; then
    mkdir -p "${DEFAULT_WORKSPACE}" 2>/dev/null || sudo mkdir -p "${DEFAULT_WORKSPACE}" || true
fi

HOME_OWNER=$(stat -c %u "${HOME}")
if [ "${HOME_OWNER}" != "$(id -u)" ]; then
    echo "entrypointd: home ${HOME} owned by uid ${HOME_OWNER}, runtime uid $(id -u) - chowning (one-time)"
    sudo chown -R "$(id -u):$(id -g)" "${HOME}"
fi
