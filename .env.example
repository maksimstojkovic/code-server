# Copy to .env; compose reads it automatically. Changing PUID/PGID after data
# exists re-chowns the home mount on next start.

PUID=1000
PGID=1000
TZ=Australia/Sydney

# code-server login: none (no login) or password. Defaults to none.
#AUTH=none

# Login password when AUTH=password
#PASSWORD=changeme

# Folder code-server opens on startup (created if missing). Defaults to /home/coder/workspace.
#DEFAULT_WORKSPACE=/home/coder/workspace

# code-server port (container + host). Update SWAG if changed.
#CODE_SERVER_PORT=8080

# Run the opencode web server in this container. Defaults to false if unset.
OPENCODE_WEB=true
#OPENCODE_WEB_PORT=4096
#OPENCODE_WEB_HOSTNAME=0.0.0.0
#OPENCODE_SERVER_PASSWORD=  # password for the opencode web server (recommended)

# OpenRouter key; opencode reads it natively (no /connect).
#OPENROUTER_API_KEY=sk-or-v1-...

# 9Router (self-hosted OpenAI-compatible gateway). Set BASE_URL to enable.
# /v1/compress (headroom) token compression is automatic. To default to a
# 9Router model, set OPENCODE_MODEL=9router/<model>.
#N9ROUTER_BASE_URL=http://<host>:20128/v1
#N9ROUTER_API_KEY=sk-9router-...
#N9ROUTER_MODEL=openrouter/glm-5.3-flash

# Default model; applied on every start (change + restart to update).
OPENCODE_MODEL=openrouter/z-ai/glm-5.3-flash

# OpenRouter zero-data-retention (per request). Set false to allow retention.
OPENCODE_ZDR=true

# Tavily web search (MCP). Set the key to enable.
#TAVILY_API_KEY=tvly-...
#TAVILY_MCP_URL=https://mcp.tavily.com/mcp

# Cosmetic username inside the container (sudo, shell prompt)
#DOCKER_USER=coder
