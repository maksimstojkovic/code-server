# Copy to .env (docker compose reads it automatically) and adjust as needed.
# Changing PUID/PGID after data exists applies a one-time ownership fix on the
# next container start.

PUID=1000
PGID=1000
TZ=Australia/Sydney

# code-server login: none (no login screen, immediate use) or password
# (see PASSWORD below). Use password only if code-server itself is exposed
# without another auth layer (e.g. SWAG) in front of it.
AUTH=none

# Plain login password (overrides the auto-generated one in config.yaml)
#PASSWORD=changeme

# Folder code-server opens on startup (created if missing; must be under
# /home/coder so it lives in the volume)
DEFAULT_WORKSPACE=/home/coder/workspace

# Port code-server listens on, inside the container and mapped to the host
# (same number both sides). Update your SWAG proxy conf if you change it.
#CODE_SERVER_PORT=8080

# opencode web server (opencode serve) in the same container. Enabled here by
# default in the example; if you remove this line the compose default is false.
OPENCODE_WEB=true
#OPENCODE_WEB_PORT=4096
#OPENCODE_WEB_HOSTNAME=0.0.0.0
#OPENCODE_SERVER_PASSWORD=  # password protecting the opencode web server (recommended)

# OpenRouter: opencode reads this key natively - no manual /connect needed.
#OPENROUTER_API_KEY=sk-or-v1-...

# Default model (full ID). Avoids manual /models setup on first run; does not
# override a model you set yourself in the config.
OPENCODE_MODEL=openrouter/z-ai/glm-5.3-flash

# Optional: cosmetic username inside the container (sudo, shell prompt)
#DOCKER_USER=coder
