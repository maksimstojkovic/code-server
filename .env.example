PUID=1000
PGID=1000
TZ=Australia/Sydney

# code-server login: none (no login) or password. Defaults to none.
#AUTH=none

# Login password when AUTH=password
#PASSWORD=changeme

# Folder code-server opens on startup (created if missing). Defaults to /home/coder/workspace.
#DEFAULT_WORKSPACE=/home/coder/workspace

# code-server port (container + host). Update SWAG if changed.
#CODE_SERVER_PORT=8080

# Run the opencode web server in this container. Defaults to false if unset.
OPENCODE_WEB=true
#OPENCODE_WEB_PORT=4096
#OPENCODE_WEB_HOSTNAME=0.0.0.0
#OPENCODE_SERVER_PASSWORD=          # password for the opencode web server (recommended)

# OpenRouter key; opencode reads it natively (no /connect).
#OPENROUTER_API_KEY=sk-or-v1-...

# 9Router (self-hosted OpenAI-compatible gateway). Set BASE_URL to enable;
# /v1/compress (headroom) token compression is automatic. When enabled,
# N9ROUTER_MODEL becomes the web server's default model.
#N9ROUTER_BASE_URL=http://<host>:20128/v1
#N9ROUTER_API_KEY=sk-9router-...
#N9ROUTER_PROVIDER=9Router          # opencode provider name (model appears as <provider>/<model>)
#N9ROUTER_MODEL=openrouter/glm-5.3-flash
#N9ROUTER_AUTO_MODELS=true          # sync the full model list at startup

# Local LLM (OpenAI-compatible, e.g. Ollama / LM Studio / vLLM). Set BASE_URL
# and MODEL to register it as an opencode provider option. MODEL may be a
# comma-separated list. Use OPENCODE_MODEL=<LOCAL_LLM_PROVIDER>/<model> to make
# it the default.
#LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
#LOCAL_LLM_MODEL=gemma4:12b-it-qat  # model id(s), comma-separated for multiple
#LOCAL_LLM_NAME=Gemma 4 12B IT QAT  # model display name shown in opencode
#LOCAL_LLM_PROVIDER=Local           # provider name (shown as the provider)
#LOCAL_LLM_API_KEY=

# Default model; applied on every start (change + restart to update).
OPENCODE_MODEL=openrouter/z-ai/glm-5.3-flash

# Auto-permission rules (JSON). Lets tools proceed without a confirmation
# prompt - useful on mobile. Merged per-key (your own rules win).
#OPENCODE_PERMISSION={"edit":"allow","read":"allow","list":"allow","glob":"allow","grep":"allow","bash":"ask"}

# OpenRouter zero-data-retention (per request). Set false to allow retention.
OPENCODE_ZDR=true

# Tavily web search (MCP). Set the key to enable.
#TAVILY_API_KEY=tvly-...
#TAVILY_MCP_URL=https://mcp.tavily.com/mcp

# Outline notes (MCP). Set the key to enable; set the URL to your instance.
# /mcp must NOT be behind an SSO login redirect - the API token does the auth.
#OUTLINE_API_KEY=ol_api_...
#OUTLINE_MCP_URL=https://outline.example.com/mcp

# Actual Budget (MCP) via actual-mcp-server (agigante80/actual-mcp-server),
# running as an HTTP/streamable server. Set the token to enable; point the URL
# at your actual-mcp-server instance.
#ACTUAL_MCP_TOKEN=your_mcp_sse_authorization_token
#ACTUAL_MCP_URL=http://actual-mcp-server:3600/http

# Cosmetic username inside the container (sudo, shell prompt)
#DOCKER_USER=coder
