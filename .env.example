# Copy to .env (docker compose reads it automatically) and adjust as needed.
# Changing PUID/PGID after data exists triggers a one-time ownership fix on
# the next container start.

PUID=1000
PGID=1000
TZ=Australia/Sydney

# Path inside the container; use a directory under /home/coder
DEFAULT_WORKSPACE=/home/coder/workspace

# Optional: cosmetic username inside the container (sudo, shell prompt)
#DOCKER_USER=coder
