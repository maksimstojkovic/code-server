# Copy to .env (docker compose reads it automatically) and adjust as needed.
# Changing PUID/PGID after data exists applies a one-time ownership fix on the
# next container start.

PUID=1000
PGID=1000
TZ=Australia/Sydney

# code-server login: password (see PASSWORD below) or none
# (none = no login screen, immediate use; only if something in front of
# code-server already handles auth, e.g. SWAG)
AUTH=password

# Plain login password (overrides the auto-generated one in config.yaml)
#PASSWORD=changeme

# Folder code-server opens on startup (created if missing; must be under
# /home/coder so it lives in the volume)
DEFAULT_WORKSPACE=/home/coder/workspace

# opencode web server (opencode serve) in the same container: set to 1 to
# enable. Host port is mapped to the same number as OPENCODE_WEB_PORT.
#OPENCODE_WEB=0
#OPENCODE_WEB_PORT=4000
#OPENCODE_WEB_HOSTNAME=0.0.0.0
#OPENCODE_SERVER_PASSWORD=  # password protecting the opencode web server (recommended)

# Optional: cosmetic username inside the container (sudo, shell prompt)
#DOCKER_USER=coder
